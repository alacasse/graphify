FROM python:3.12-slim@sha256:09f7da3bc104798d0afb40bc08d23ab2da20a76130cec1f2ef170848f5d85217

ENV HOME=/sandbox/home \
    XDG_CONFIG_HOME=/sandbox/xdg \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

RUN mkdir -p \
        /opt/install-sandbox \
        /sandbox/home \
        /sandbox/output \
        /sandbox/project \
        /sandbox/source \
        /sandbox/subject \
        /sandbox/work \
        /sandbox/xdg \
    && chmod 1777 \
        /sandbox/home \
        /sandbox/output \
        /sandbox/project \
        /sandbox/source \
        /sandbox/work \
        /sandbox/xdg

COPY --chmod=0555 docker_probe.py /opt/install-sandbox/probe.py

WORKDIR /sandbox/work

ENTRYPOINT ["python", "-B", "/opt/install-sandbox/probe.py"]
