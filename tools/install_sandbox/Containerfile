FROM python:3.12-slim@sha256:09f7da3bc104798d0afb40bc08d23ab2da20a76130cec1f2ef170848f5d85217

ENV HOME=/sandbox/home \
    XDG_CONFIG_HOME=/sandbox/xdg \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

RUN mkdir -p /opt/install-sandbox/tools/install_sandbox \
        /sandbox/home /sandbox/xdg /sandbox/output /sandbox/work \
    && chmod 1777 /sandbox/home /sandbox/xdg /sandbox/work

COPY --chmod=0444 case.py spec.py driver.py environment.py results.py timings.py \
    runner.py verifier.py container_main.py /opt/install-sandbox/tools/install_sandbox/
COPY subject/ /opt/install-sandbox/reference/
RUN cp -a /opt/install-sandbox/reference /tmp/package \
    && python -m venv /opt/install-sandbox/venv \
    && /opt/install-sandbox/venv/bin/python -m pip install --disable-pip-version-check /tmp/package \
    && rm -rf /tmp/package \
    && chmod -R a+rX /opt/install-sandbox

WORKDIR /sandbox/work
ENTRYPOINT ["python", "-I", "-B", "-u", "/opt/install-sandbox/tools/install_sandbox/container_main.py"]
