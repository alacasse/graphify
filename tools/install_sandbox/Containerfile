FROM python:3.12-slim@sha256:09f7da3bc104798d0afb40bc08d23ab2da20a76130cec1f2ef170848f5d85217

ENV HOME=/sandbox/home \
    XDG_CONFIG_HOME=/sandbox/xdg \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

RUN mkdir -p /opt/install-sandbox/tools/install_sandbox \
        /sandbox/home /sandbox/xdg /sandbox/output /sandbox/subject /sandbox/work \
    && chmod 1777 /sandbox/home /sandbox/xdg /sandbox/work

# Only the sandbox's internal case program is embedded, never the tested product.
COPY --chmod=0444 case.py spec.py driver.py environment.py preparer.py \
    results.py runner.py verifier.py container_main.py /opt/install-sandbox/tools/install_sandbox/

WORKDIR /sandbox/work

ENTRYPOINT ["python", "-I", "-B", "-u", "/opt/install-sandbox/tools/install_sandbox/container_main.py"]
